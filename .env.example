# Copie este arquivo para .env e ajuste os valores. Nunca versione o .env.

APP_NOME="Portal de Capacitação Patrimonial"
# production ou local
APP_ENV=production
# true mostra detalhes de erro na tela. Use true somente em desenvolvimento.
APP_DEBUG=false
SESSAO_MINUTOS=30

DB_HOST=localhost
DB_PORT=3306
DB_NAME=portal_patrimonial
DB_USER=portal_app
DB_PASS=

# Chave secreta (obrigatória para o autocadastro). Gere com:
#   php -r "echo bin2hex(random_bytes(32));"
# Gere uma vez e NÃO altere depois, ou os CPFs já cadastrados deixam de ser reconhecidos.
APP_KEY=68cc9fad8361b37af4910aa1473cccdf8c399a0f1a548b4ab9b4512d9e69dfe9

# Autocadastro: false libera o acesso na hora; true exige aprovação de um administrador.
CADASTRO_REQUER_APROVACAO=false
# Máximo de cadastros por hora vindos do mesmo IP (proteção contra abuso).
CADASTRO_MAX_POR_HORA_IP=20

# Opcional: endereço público para links de e-mail (sem barra no final)
APP_URL=

# E-mail: log (grava em storage/logs/emails.log) ou mail (função mail() do PHP)
MAIL_DRIVER=log
MAIL_FROM=nao-responda@localhost

# Limites de upload em MB
UPLOAD_DOCUMENTO_MB=20
UPLOAD_VIDEO_MB=200
